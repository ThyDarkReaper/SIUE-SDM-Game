    id int(10) NOT NULL,
    username varchar(36) NOT NULL,
    hash varchar(100) NOT NULL,
    salt varchar(50) NOT NULL,
    characterID int(11) NOT NULL DEFAULT 1111111,
    level1score int(11) DEFAULT NULL,
    level2score int(11) DEFAULT NULL,
    level3score int(11) DEFAULT NULL,
    level4score int(11) DEFAULT NULL,
    level5score int(11) DEFAULT NULL,
    level6score int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

